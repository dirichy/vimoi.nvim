Require nvim
Require chezmoi
Set Shell "bash"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 36
Set Width 2560
Set Height 1440
Set Theme "TokyoNight"
Set Framerate 30
Set Margin 88
Set MarginFill "docs/demos/common/backdrop.png"
Set WindowBar Colorful
Set WindowBarSize 56
Set BorderRadius 28
Set Padding 16
Set TypingSpeed 35ms
