    "fixture": "tests/fixtures/environment; shared isolated TOML config and destination; source explicit; config selected using XDG_CONFIG_HOME and wrapper",
    "profile_lua": "vim.opt.rtp:prepend(vim.env.VIMOI_PROFILE_ROOT or vim.fn.getcwd())\nvim.cmd(\"filetype plugin on\")\nlocal measurements = {}\nlocal original = vim.system\nvim.system = function(argv, opts, callback)\n  local started = vim.uv.hrtime()\n  local process = original(argv, opts, callback)\n  local wait = process.wait\n  process.wait = function(self, ...)\n    local result = wait(self, ...)\n    measurements[#measurements + 1] = { command = table.concat(argv, ' '), ms = (vim.uv.hrtime() - started) / 1e6 }\n    return result\n  end\n  return process\nend\nlocal started = vim.uv.hrtime()\nlocal plugin = require('vimoi')\nlocal loaded = vim.uv.hrtime()\nlocal cpu_loaded = os.clock()\nplugin.setup({chezmoi_executable = vim.env.VIMOI_PROFILE_FIXTURE .. '/chezmoi-wrapper.sh', chezmoi_source_dir = vim.env.VIMOI_TEST_SOURCE, diagnostics = {enabled = false}, highlight = {mode = 'disabled'}})\nlocal configured = vim.uv.hrtime()\nlocal setup_cpu_ms = (os.clock()-cpu_loaded)*1000\nvim.cmd('edit ' .. vim.fn.fnameescape(vim.env.VIMOI_TEST_SOURCE .. '/dot_diff_target.tmpl'))\nvim.wait(1000, function() return vim.b.vimoi_template_configured == true end)\nprint(vim.json.encode({require_ms = (loaded-started)/1e6, setup_ms = (configured-loaded)/1e6, first_buffer_ms = (vim.uv.hrtime()-configured)/1e6, setup_cpu_ms = setup_cpu_ms, commands = measurements}))\nvim.cmd('qa!')\n"
  },
