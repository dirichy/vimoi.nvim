    "order": "alternating; fresh Neovim per sample; no concurrent tests or LSP checks",
    "source": "local default source; same source/config paths and unmodified tree for both variants; default plugin options",
    "scope": "blank-buffer require/setup wall and parent CPU; excludes Neovim process startup and chezmoi child CPU; first_watch_ms calls internal start after setup to isolate deferred scanning, not an end-to-end CLI operation",
    "profile_lua": "vim.opt.rtp:prepend(assert(vim.env.VIMOI_PROFILE_ROOT))\nlocal processes = 0\nlocal system = vim.system\nvim.system = function(...) processes = processes + 1; return system(...) end\nlocal cpu_started = os.clock()\nlocal started = vim.uv.hrtime()\nlocal plugin = require('vimoi')\nlocal loaded = vim.uv.hrtime()\nlocal cpu_loaded = os.clock()\nplugin.setup()\nlocal configured = vim.uv.hrtime()\nlocal setup_cpu_ms = (os.clock() - cpu_loaded) * 1000\nlocal require_setup_cpu_ms = (os.clock() - cpu_started) * 1000\nlocal first_watch_started = vim.uv.hrtime()\nlocal watch = require('vimoi.core.watch')\nif watch.start then watch.start() end\nlocal first_watch_ms = (vim.uv.hrtime() - first_watch_started) / 1e6\nprint(vim.json.encode({require_ms=(loaded-started)/1e6,setup_ms=(configured-loaded)/1e6,require_setup_ms=(configured-started)/1e6,setup_cpu_ms=setup_cpu_ms,require_setup_cpu_ms=require_setup_cpu_ms,first_watch_ms=first_watch_ms,processes=processes}))\nvim.cmd('qa!')\n"
  },
