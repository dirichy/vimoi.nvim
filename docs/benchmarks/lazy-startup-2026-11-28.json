{
  "metadata": {
    "baseline": "b70e54f plus the previously tested deferred-watch worktree changes",
    "baseline_lua_patch": "diff --git a/lua/vimoi/core/cli.lua b/lua/vimoi/core/cli.lua\nindex 74fec3c..89cd5d0 100644\n--- a/lua/vimoi/core/cli.lua\n+++ b/lua/vimoi/core/cli.lua\n@@ -122,6 +122,7 @@ end)\n ---@return string? output\n ---@return string? error\n function M.run(args, opts)\n+  require(\"vimoi.core.watch\").start()\n   opts = opts or {}\n   local argv = vim.list_extend(vim.list_slice(chezmoi_command), args)\n   -- Commands that can consult data/password helpers stay cancellable and asynchronous.\n@@ -419,6 +420,7 @@ end\n ---@param source_dir string\n ---@return string[]\n function M.template_directories(source_dir)\n+  require(\"vimoi.core.watch\").start()\n   source_dir = util.normalize_path(source_dir)\n   if not cache.directories[source_dir] then\n     cache.directories[source_dir] = vim.fs.find(\".chezmoitemplates\", {\ndiff --git a/lua/vimoi/core/watch.lua b/lua/vimoi/core/watch.lua\nindex 2928c70..1b0de1b 100644\n--- a/lua/vimoi/core/watch.lua\n+++ b/lua/vimoi/core/watch.lua\n@@ -21,6 +21,7 @@ local config\n -- so atomic replacement does not detach a watch; refresh discovers new folders.\n -- Index only successfully started watchers by their directly monitored directory.\n local watchers = {}\n+local started = false\n ---@type VimoiCacheScope?\n local pending_scope\n \n@@ -51,6 +52,7 @@ function M.refresh()\n   if not config then\n     return\n   end\n+  started = true\n   for _, watcher in pairs(watchers) do\n     watcher:stop()\n     watcher:close()\n@@ -84,7 +86,7 @@ function M.refresh()\n   for directory in pairs(directories) do\n     local watcher = vim.uv.new_fs_event()\n     if watcher then\n-      local started = watcher:start(directory, {}, function(err, filename)\n+      local ok = watcher:start(directory, {}, function(err, filename)\n         if err then\n           if watchers[directory] == watcher then\n             watchers[directory] = nil\n@@ -117,7 +119,7 @@ function M.refresh()\n           require(\"vimoi.core.cli\").invalidate(scope_to_invalidate)\n         end)\n       end)\n-      if started then\n+      if ok then\n         watchers[directory] = watcher\n       else\n         -- No active entry: buffer writes automatically fall back for this directory.\n@@ -127,12 +129,18 @@ function M.refresh()\n   end\n end\n \n+---Start watching before the first query/cache fill; explicit refresh also starts it.\n+function M.start()\n+  if not started then\n+    M.refresh()\n+  end\n+end\n+\n ---@param opts VimoiWatchConfig\n M.setup = util.once(function(opts)\n   config = vim.tbl_extend(\"force\", { rules = default_rules, buffer_write_fallback = \"auto\" }, opts)\n   -- Always watch the selected config, without inserting into the caller's rules.\n   config.rules = vim.list_extend({ { path = config.config_path, scope = \"all\", watch = \"parent\" } }, config.rules)\n-  M.refresh()\n   local group = vim.api.nvim_create_augroup(\"vimoi-cli-cache\", { clear = true })\n   if config.buffer_write_fallback == false then\n     return\n",
    "nvim": "NVIM v0.12.6",
    "cpu": 0,
    "samples_per_mode_variant": 15,
    "order": "alternating variants; fresh Neovim per sample; no concurrent tests/LSP checks",
    "scope": "require/setup wall and parent CPU, excluding Neovim process startup and screen painting; first source includes synchronous target-path, watcher activation and automatic rendering to a published output map",
    "options": "defaults; first-source mode uses the same isolated fixture identity and destination for both versions",
    "profile_lua": "vim.opt.rtp:prepend(assert(vim.env.VIMOI_PROFILE_ROOT))\nif vim.env.VIMOI_PROFILE_FILETYPES == '1' then vim.cmd('filetype plugin on') end\nlocal processes = 0\nlocal system = vim.system\nvim.system = function(...) processes = processes + 1; return system(...) end\nlocal opts = {}\nif vim.env.VIMOI_PROFILE_SOURCE == '1' then\n  local fixture=assert(vim.env.VIMOI_PROFILE_FIXTURE)\n  opts={chezmoi_executable=fixture..'/chezmoi-wrapper.sh',chezmoi_source_dir=fixture..'/source',chezmoi_config_path=fixture..'/empty.toml'}\nend\nlocal started=vim.uv.hrtime()\nlocal cpu_started=os.clock()\nlocal plugin=require('vimoi')\nlocal loaded=vim.uv.hrtime()\nplugin.setup(opts)\nlocal configured=vim.uv.hrtime()\nlocal startup_cpu_ms=(os.clock()-cpu_started)*1000\nlocal startup_processes=processes\nlocal modules={}\nfor name in pairs(package.loaded) do if name:match('^vimoi') then modules[#modules+1]=name end end\ntable.sort(modules)\nlocal first_source_ms\nif vim.env.VIMOI_PROFILE_SOURCE=='1' then\n  assert(vim.env.VIMOI_PROFILE_FILETYPES=='1')\n  local first=vim.uv.hrtime()\n  vim.cmd.edit(vim.fn.fnameescape(opts.chezmoi_source_dir..'/dot_diff_target.tmpl'))\n  local buf=vim.api.nvim_get_current_buf()\n  assert(vim.wait(10000,function()\n    local sessions=package.loaded['vimoi.render']\n    local state=sessions and sessions.get(buf)\n    return vim.b[buf].vimoi_template_configured==true and state and state.map and not state.error and not state.request\n  end,1),'first automatic render did not finish')\n  first_source_ms=(vim.uv.hrtime()-first)/1e6\nend\nprint(vim.json.encode({require_ms=(loaded-started)/1e6,setup_ms=(configured-loaded)/1e6,startup_ms=(configured-started)/1e6,startup_cpu_ms=startup_cpu_ms,startup_processes=startup_processes,first_source_ms=first_source_ms,processes=processes,modules=modules}))\nvim.cmd('qa!')\n",
    "production_line_change": {
      "added": 58,
      "removed": 58,
      "net": 0,
      "scope": "Lua only, relative to the pre-task deferred-watch snapshot; includes whitespace/comments/types; excludes tests/docs"
    }
  },
